{
  "expo": {
    "name": "BSMP Driver",
    "slug": "bsmp-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bsmpdriver",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.bsmp.driver"
    },
    "android": {
      "package": "in.bsmp.driver",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
