{
  "name": "bsmp-driver-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "BSMP driver mobile app (Expo / React Native). Intentionally NOT an npm workspace member of the web app: it keeps its own node_modules to avoid React-version conflicts with Next.js, and is built/shipped via Expo EAS rather than Vercel. Run npm install from inside this folder, never from the repo root.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.12",
    "typescript": "~5.9.0"
  }
}
