# Expo / React Native
# No trailing slash: a trailing slash only matches a real directory, not a
# symlink — and node_modules may be a symlink (see ~/.local-node-modules, used
# to keep it off this Mac's iCloud-synced Desktop folder).
node_modules
.expo/
dist/
web-build/
*.log

# Native
ios/
android/

# Env
.env
.env.local

