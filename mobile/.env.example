# Base URL of the web app that serves /api/driver/*.
# A phone cannot reach "localhost" — use your computer's LAN IP for local dev,
# or the deployed dev/prod URL.
#
# Copy this file to `.env` and adjust.
EXPO_PUBLIC_API_URL=http://192.168.1.5:3000

# Only needed when EXPO_PUBLIC_API_URL points at a Vercel PREVIEW deployment —
# Preview is protected by Vercel Deployment Protection (Production is not).
# Get this value from Vercel: Project Settings -> Deployment Protection ->
# Protection Bypass for Automation. Leave unset when targeting Production or a
# local/LAN server.
EXPO_PUBLIC_VERCEL_PROTECTION_BYPASS=
