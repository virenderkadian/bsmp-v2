# Copy this file to ".env" in the same folder and fill it in.
# This file sits next to the script on purpose — a Windows service does not
# inherit the environment of whoever installed it.

# ---- Where the queue lives (the web app) ----
APP_BASE_URL=https://atmv2.bsmp.in
# Must match NOTIFICATIONS_AGENT_SECRET in the web app's environment.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SECRET=

# ---- Where messages go out (OpenWA on this machine) ----
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=bsmp

# ---- Pacing ----
# The gap between messages, randomised within this range. Do not lower these
# without a reason: fast bulk sending is the main cause of WhatsApp bans, and
# 20-30s is what makes ~2000 bills a day-and-a-half job rather than a 3-hour one.
MIN_GAP_SECONDS=20
MAX_GAP_SECONDS=30

# Business hours (24h, local). Messages at 3am read as machine-generated.
SEND_START_HOUR=9
SEND_END_HOUR=21

# IST. Change only if the business moves.
UTC_OFFSET_MINUTES=330

# Hard stop per day, counted by the server so restarting the PC cannot reset it.
DAILY_CAP=1200

# Warm-up. A new number sending 2000 messages in its first week looks like a
# spammer no matter how slowly it does it. Start at 200, raise it every few
# weeks, and delete this line once the number has months of history.
WARMUP_CAP=200

# How many to claim at once. Small batches limit what is stranded if this
# machine is switched off mid-batch.
BATCH_SIZE=25

# Stop everything after this many consecutive send failures. That pattern is
# the earliest sign of a restricted number, and continuing makes it worse.
BREAKER_THRESHOLD=8
